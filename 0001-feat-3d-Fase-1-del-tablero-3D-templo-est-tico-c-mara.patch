+--!nonstrict
+-- AEVUM · Tablero 3D: templo estático (v1.3.0)
+-- Construye UNA sola vez la mesa de piedra y oro con surcos y glifos de neón.
+-- No conoce el estado de la partida: solo geometría. Las cartas las pone Board3D (Fase 2).
+
+local Lighting = game:GetService("Lighting")
+
+local Layout = require(script.Parent.Layout)
+
+local BoardBuilder = {}
+
+local PAL = {
+	stone = Color3.fromRGB(40, 38, 48),
+	tier2 = Color3.fromRGB(28, 26, 34),
+	tier3 = Color3.fromRGB(21, 20, 27),
+	floor = Color3.fromRGB(13, 12, 18),
+	slot = Color3.fromRGB(30, 29, 38),
+	gold = Color3.fromRGB(176, 138, 66),
+	glyph = Color3.fromRGB(255, 196, 110), -- neón neutro (ámbar)
+	Self = Color3.fromRGB(77, 225, 255), -- cian = jugador
+	Enemy = Color3.fromRGB(255, 90, 170), -- rosa = rival
+}
+BoardBuilder.Palette = PAL
+
+local SLOTS = 5
+local CYL = CFrame.Angles(0, 0, math.pi / 2) -- un cilindro de Roblox tiene el eje en X: lo giramos para que mire hacia arriba
+
+-- Construye el templo. origin: Vector3 del centro de la mesa. quality: "High" | "Low".
+-- Devuelve { folder, glow, refs }:
+--   glow: partes de neón que pueden pulsar (solo calidad alta)
+--   refs: partes con nombre que usarán las fases siguientes (casillas, cristales, orbe)
+function BoardBuilder.build(origin, quality)
+	local high = quality ~= "Low"
+	local folder = Instance.new("Folder")
+	folder.Name = "AevumBoard3D"
+	local glow = {}
+	local refs = { slots = {}, vitals = {}, decks = {}, graveyards = {} }
+
+	-- Crea una pieza anclada. pos es relativa al centro de la mesa.
+	local function part(name, size, pos, color, material, opts)
+		opts = opts or {}
+		local p = Instance.new("Part")
+		p.Name = name
+		p.Anchored = true
+		p.CanCollide = false
+		p.CanTouch = false
+		p.CanQuery = false -- decorado: no estorba al raycast de la Fase 3
+		p.Size = size
+		p.Color = color
+		p.Material = material or Enum.Material.Slate
+		p.TopSurface = Enum.SurfaceType.Smooth
+		p.BottomSurface = Enum.SurfaceType.Smooth
+		p.CastShadow = high and math.max(size.X, size.Y, size.Z) >= 2
+		if opts.transparency then p.Transparency = opts.transparency end
+		if opts.shape then p.Shape = opts.shape end
+		p.CFrame = CFrame.new(origin + pos) * (opts.rot or CFrame.new())
+		if opts.glow then glow[#glow + 1] = p end
+		p.Parent = folder
+		return p
+	end
+
+	local function light(parent, color, range, brightness)
+		if not high then return end
+		local l = Instance.new("PointLight")
+		l.Color = color
+		l.Range = range
+		l.Brightness = brightness
+		l.Shadows = false
+		l.Parent = parent
+	end
+
+	local half = Layout.halfExtents()
+	local hx, hz = half.x, half.z
+
+	-- ── Suelo y escalones (ziggurat) ───────────────────────────────────────
+	part("Suelo", Vector3.new(600, 1, 600), Vector3.new(0, -5, 0), PAL.floor, Enum.Material.Basalt)
+	part("Escalon3", Vector3.new(hx * 2 + 12, 1.5, hz * 2 + 12), Vector3.new(0, -3.75, 0), PAL.tier3, Enum.Material.Basalt)
+	part("Escalon2", Vector3.new(hx * 2 + 6, 1.5, hz * 2 + 6), Vector3.new(0, -2.25, 0), PAL.tier2, Enum.Material.Basalt)
+	part("Mesa", Vector3.new(hx * 2, 1.5, hz * 2), Vector3.new(0, -0.75, 0), PAL.stone, Enum.Material.Slate)
+
+	-- ── Marco de oro envejecido ────────────────────────────────────────────
+	local METAL = Enum.Material.Metal
+	part("MarcoN", Vector3.new(hx * 2 + 1.6, 0.5, 0.8), Vector3.new(0, 0.25, -(hz + 0.4)), PAL.gold, METAL)
+	part("MarcoS", Vector3.new(hx * 2 + 1.6, 0.5, 0.8), Vector3.new(0, 0.25, hz + 0.4), PAL.gold, METAL)
+	part("MarcoW", Vector3.new(0.8, 0.5, hz * 2), Vector3.new(-(hx + 0.4), 0.25, 0), PAL.gold, METAL)
+	part("MarcoE", Vector3.new(0.8, 0.5, hz * 2), Vector3.new(hx + 0.4, 0.25, 0), PAL.gold, METAL)
+
+	-- ── Nicho rectangular: placa oscura + 4 bordes de oro + franja de neón ──
+	-- stripDz: desplazamiento en Z de la franja de neón respecto al centro del nicho.
+	local function socket(name, cx, cz, color, stripDz)
+		local W, D = 4.8, 6.4
+		local base = part(name, Vector3.new(4.5, 0.1, 6.1), Vector3.new(cx, 0.05, cz), PAL.slot, Enum.Material.Basalt)
+		part(name .. "_BordeN", Vector3.new(W, 0.25, 0.3), Vector3.new(cx, 0.125, cz - D / 2 + 0.15), PAL.gold, METAL)
+		part(name .. "_BordeS", Vector3.new(W, 0.25, 0.3), Vector3.new(cx, 0.125, cz + D / 2 - 0.15), PAL.gold, METAL)
+		part(name .. "_BordeW", Vector3.new(0.3, 0.25, D - 0.6), Vector3.new(cx - W / 2 + 0.15, 0.125, cz), PAL.gold, METAL)
+		part(name .. "_BordeE", Vector3.new(0.3, 0.25, D - 0.6), Vector3.new(cx + W / 2 - 0.15, 0.125, cz), PAL.gold, METAL)
+		part(name .. "_Glifo", Vector3.new(3, 0.06, 0.16), Vector3.new(cx, 0.12, cz + stripDz), color, Enum.Material.Neon)
+		return base
+	end
+
+	-- ── Casillas de Combate y Banca (ambos bandos) ─────────────────────────
+	for _, side in ipairs({ "Self", "Enemy" }) do
+		local sgn = side == "Self" and 1 or -1
+		for _, zone in ipairs({ "Combat", "Bench" }) do
+			-- Combate: la franja mira al centro. Banca: mira al borde exterior.
+			local dz = (zone == "Combat" and -sgn or sgn) * 2.7
+			for i = 1, SLOTS do
+				local p = Layout.slot(side, zone, i, SLOTS)
+				local name = ("Casilla_%s_%s_%d"):format(side, zone, i)
+				refs.slots[("%s:%s:%d"):format(side, zone, i)] = socket(name, p.x, p.z, PAL[side], dz)
+			end
+		end
+	end
+
+	-- ── Surcos tipo circuito ───────────────────────────────────────────────
+	local NEON = Enum.Material.Neon
+	-- Franja central: surco horizontal a ambos lados del orbe, con nodos
+	for _, sx in ipairs({ -1, 1 }) do
+		local len = hx - 2 - 2.6
+		part("Surco", Vector3.new(len, 0.05, 0.14), Vector3.new(sx * (2.6 + len / 2), 0.03, 0), PAL.glyph, NEON, { glow = true })
+		for _, nx in ipairs({ 6, 11, 16 }) do
+			part("Nodo", Vector3.new(0.5, 0.1, 0.5), Vector3.new(sx * nx, 0.05, 0), PAL.glyph, NEON, { glow = true })
+		end
+		for _, sz in ipairs({ -1, 1 }) do
+			part("SurcoFino", Vector3.new(5.6, 0.05, 0.1), Vector3.new(sx * 6.2, 0.03, sz * 1.3), PAL.glyph, NEON)
+		end
+	end
+	-- Surcos de cada bando entre Combate y Banca: enlazan el cristal con las filas
+	local channelZ = (Layout.ROW_COMBAT + 3.2 + Layout.ROW_BENCH - 3.2) / 2
+	local x0, x1 = -(Layout.SIDE_X - 2), Layout.slotX(SLOTS, SLOTS) + 2.4
+	for _, side in ipairs({ "Self", "Enemy" }) do
+		local sgn = side == "Self" and 1 or -1
+		part("Canal_" .. side, Vector3.new(x1 - x0, 0.05, 0.14), Vector3.new((x0 + x1) / 2, 0.03, sgn * channelZ), PAL[side], NEON)
+	end
+
+	-- ── Orbe central (sobre un sello de dos anillos) ───────────────────────
+	part("SelloAnillo", Vector3.new(0.06, 4.4, 4.4), Vector3.new(0, 0.04, 0), PAL.glyph, NEON, { rot = CYL, glow = true })
+	part("SelloBase", Vector3.new(0.06, 4.0, 4.0), Vector3.new(0, 0.07, 0), PAL.slot, Enum.Material.Basalt, { rot = CYL })
+	part("SelloRuna", Vector3.new(0.06, 2.8, 2.8), Vector3.new(0, 0.1, 0), PAL.glyph, NEON, { rot = CYL, glow = true })
+	part("SelloNucleo", Vector3.new(0.06, 2.4, 2.4), Vector3.new(0, 0.13, 0), PAL.slot, Enum.Material.Basalt, { rot = CYL })
+	local orb = part("Orbe", Vector3.new(1.6, 1.6, 1.6), Vector3.new(0, Layout.ORB_Y, 0), PAL.glyph, NEON,
+		{ shape = Enum.PartType.Ball, glow = true })
+	light(orb, PAL.glyph, 18, 1.4)
+	refs.orb = orb
+
+	-- ── Columna lateral: cristal de vida, mazo y cementerio de cada bando ──
+	for _, side in ipairs({ "Self", "Enemy" }) do
+		local sgn = side == "Self" and 1 or -1
+		local color = PAL[side]
+
+		local v = Layout.vital(side)
+		part("CristalBase_" .. side, Vector3.new(0.4, 4.4, 4.4), Vector3.new(v.x, 0.2, v.z), PAL.gold, METAL, { rot = CYL })
+		part("CristalNucleo_" .. side, Vector3.new(0.34, 3.8, 3.8), Vector3.new(v.x, 0.17, v.z), PAL.slot, Enum.Material.Basalt, { rot = CYL })
+		local crystal = part("Cristal_" .. side, Vector3.new(1.6, 1.6, 1.6), Vector3.new(v.x, 2.6, v.z), color, NEON,
+			{ transparency = 0.1, rot = CFrame.Angles(math.rad(45), math.rad(45), 0), glow = true })
+		light(crystal, color, 12, 1.2)
+		refs.vitals[side] = crystal
+
+		local d = Layout.deck(side)
+		socket("Mazo_" .. side, d.x, d.z, color, sgn * 2.7)
+		refs.decks[side] = part("MazoPila_" .. side, Vector3.new(4, 0.5, 5.6), Vector3.new(d.x, 0.4, d.z),
+			Color3.fromRGB(46, 40, 62), METAL)
+
+		local g = Layout.graveyard(side)
+		refs.graveyards[side] = socket("Cementerio_" .. side, g.x, g.z, color, -sgn * 2.7)
+	end
+
+	-- ── Pilares con brasero en las cuatro esquinas ─────────────────────────
+	for _, sx in ipairs({ -1, 1 }) do
+		for _, sz in ipairs({ -1, 1 }) do
+			local px, pz = sx * (hx + 1.2), sz * (hz + 1.2)
+			local color = sz == 1 and PAL.Self or PAL.Enemy
+			part("Pilar", Vector3.new(1.8, 6.5, 1.8), Vector3.new(px, 1.75, pz), PAL.tier2, Enum.Material.Basalt)
+			part("PilarCapitel", Vector3.new(2.4, 0.4, 2.4), Vector3.new(px, 5.2, pz), PAL.gold, METAL)
+			local flame = part("PilarLlama", Vector3.new(1, 1, 1), Vector3.new(px, 6, pz), color, NEON,
+				{ shape = Enum.PartType.Ball, glow = true })
+			light(flame, color, 14, 1)
+		end
+	end
+
+	return { folder = folder, glow = glow, refs = refs }
+end
+
+-- Atmósfera oscura de templo. Solo afecta a este cliente.
+-- Devuelve una función que restaura todo lo que cambió.
+function BoardBuilder.applyLighting(quality)
+	local high = quality ~= "Low"
+	local saved = {
+		Ambient = Lighting.Ambient,
+		OutdoorAmbient = Lighting.OutdoorAmbient,
+		Brightness = Lighting.Brightness,
+		ClockTime = Lighting.ClockTime,
+		ColorShift_Top = Lighting.ColorShift_Top,
+		GlobalShadows = Lighting.GlobalShadows,
+		ExposureCompensation = Lighting.ExposureCompensation,
+	}
+	Lighting.Ambient = Color3.fromRGB(52, 48, 70)
+	Lighting.OutdoorAmbient = Color3.fromRGB(60, 56, 84)
+	Lighting.Brightness = 2
+	Lighting.ClockTime = 16.5 -- sol bajo: luz rasante que marca el relieve de la piedra
+	Lighting.ColorShift_Top = Color3.fromRGB(255, 205, 150)
+	Lighting.GlobalShadows = high
+	Lighting.ExposureCompensation = 0
+
+	local extras = {}
+	local atmosphere = Instance.new("Atmosphere")
+	atmosphere.Name = "AevumAtmosphere"
+	atmosphere.Density = 0.25
+	atmosphere.Offset = 0
+	atmosphere.Color = Color3.fromRGB(34, 28, 56)
+	atmosphere.Decay = Color3.fromRGB(14, 12, 28)
+	atmosphere.Glare = 0
+	atmosphere.Haze = 0
+	atmosphere.Parent = Lighting
+	extras[#extras + 1] = atmosphere
+
+	if high then
+		local bloom = Instance.new("BloomEffect")
+		bloom.Name = "AevumBloom"
+		bloom.Intensity = 0.5
+		bloom.Size = 24
+		bloom.Threshold = 1
+		bloom.Parent = Lighting
+		extras[#extras + 1] = bloom
+	end
+
+	return function()
+		for k, v in pairs(saved) do Lighting[k] = v end
+		for _, e in ipairs(extras) do e:Destroy() end
+	end
+end
+
+return BoardBuilder
diff --git a/src/StarterPlayerScripts/AEVUM/UI3D/CameraRig.luau b/src/StarterPlayerScripts/AEVUM/UI3D/CameraRig.luau
new file mode 100644
index 0000000..1cdd6fd
--- /dev/null
+++ b/src/StarterPlayerScripts/AEVUM/UI3D/CameraRig.luau
@@ -0,0 +1,67 @@
+--!nonstrict
+-- AEVUM · Tablero 3D: cámara adaptable (v1.3.0)
+-- Cámara Scriptable fija sobre el lado del jugador local (+Z), inclinada hacia la mesa.
+-- La distancia se recalcula con la proporción de pantalla, así sirve en móvil y PC.
+
+local Layout = require(script.Parent.Layout)
+
+local CameraRig = {}
+
+CameraRig.FOV = 45 -- FOV vertical (grados)
+CameraRig.PITCH = 58 -- inclinación bajo el horizonte (grados)
+
+-- Toma el control de la cámara apuntando a `center` (Vector3).
+-- Devuelve una función `stop` que la devuelve a como estaba.
+function CameraRig.start(center)
+	local camera = workspace.CurrentCamera
+	while not camera do
+		task.wait()
+		camera = workspace.CurrentCamera
+	end
+	local previous = { type = camera.CameraType, fov = camera.FieldOfView, cframe = camera.CFrame }
+	local conns = {}
+
+	local function apply()
+		camera = workspace.CurrentCamera
+		if not camera then return end
+		camera.CameraType = Enum.CameraType.Scriptable
+		camera.FieldOfView = CameraRig.FOV
+		local size = camera.ViewportSize
+		local fit = Layout.cameraFit(size.X / math.max(size.Y, 1), CameraRig.FOV, CameraRig.PITCH)
+		local pitch = math.rad(CameraRig.PITCH)
+		local forward = Vector3.new(0, -math.sin(pitch), -math.cos(pitch)) -- hacia -Z y hacia abajo
+		local position = center - forward * fit.distance
+		-- Bajamos la mirada `shift` para que la mesa quede centrada en el hueco que dejan los paneles 2D
+		camera.CFrame = CFrame.lookAt(position, center) * CFrame.Angles(-fit.shift, 0, 0)
+	end
+
+	local function watch()
+		for _, c in ipairs(conns) do c:Disconnect() end
+		conns = {}
+		if not camera then return end
+		conns[#conns + 1] = camera:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
+		-- Si algo (otro script, el reaparecer) cambia el tipo de cámara, lo volvemos a forzar
+		conns[#conns + 1] = camera:GetPropertyChangedSignal("CameraType"):Connect(function()
+			if camera.CameraType ~= Enum.CameraType.Scriptable then apply() end
+		end)
+	end
+
+	apply()
+	watch()
+	local camConn = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
+		apply()
+		watch()
+	end)
+
+	return function()
+		camConn:Disconnect()
+		for _, c in ipairs(conns) do c:Disconnect() end
+		if camera then
+			camera.CameraType = previous.type
+			camera.FieldOfView = previous.fov
+			camera.CFrame = previous.cframe
+		end
+	end
+end
+
+return CameraRig
diff --git a/src/StarterPlayerScripts/AEVUM/UI3D/Layout.luau b/src/StarterPlayerScripts/AEVUM/UI3D/Layout.luau
new file mode 100644
index 0000000..28ade75
--- /dev/null
+++ b/src/StarterPlayerScripts/AEVUM/UI3D/Layout.luau
@@ -0,0 +1,101 @@
+--!nonstrict
+-- AEVUM · Tablero 3D: posiciones puras (v1.3.0)
+-- Sin instancias ni tipos de Roblox: solo números y tablas, así se puede probar con `luau`.
+-- Sistema de coordenadas (relativo al centro del tablero, en studs):
+--   +X = derecha de la pantalla · +Z = hacia el jugador local · -Z = hacia el rival · Y = arriba.
+-- El jugador local siempre se ve en +Z ("Self"), el rival en -Z ("Enemy").
+-- El índice de casilla 1 queda a la izquierda para ambos bandos (igual que el tablero 2D).
+
+local Layout = {}
+
+-- Carta tumbada sobre la mesa
+Layout.CARD = { w = 4, d = 5.6, h = 0.12 }
+
+Layout.SLOT_PITCH = 5 -- distancia entre centros de casilla en X
+Layout.ROW_COMBAT = 5.6 -- |z| de la fila de Combate
+Layout.ROW_BENCH = 12.8 -- |z| de la fila de Banca
+Layout.SIDE_X = 17.5 -- |x| de las columnas laterales (cristal, mazo, cementerio)
+
+-- Alturas (Y = 0 es la superficie de la mesa)
+Layout.CARD_Y = 0.2 -- centro de una carta tumbada
+Layout.HOVER_Y = 3 -- altura de una carta "levantada"
+Layout.ORB_Y = 4 -- altura del orbe central
+
+local function sign(side)
+	return side == "Self" and 1 or -1
+end
+
+-- x de la casilla `index` de `count` casillas (centrado en 0)
+function Layout.slotX(index, count)
+	return (index - (count + 1) / 2) * Layout.SLOT_PITCH
+end
+
+-- Centro de una casilla. side: "Self" | "Enemy" · zone: "Bench" | "Combat"
+function Layout.slot(side, zone, index, count)
+	count = count or 5
+	local row = zone == "Combat" and Layout.ROW_COMBAT or Layout.ROW_BENCH
+	return { x = Layout.slotX(index, count), z = sign(side) * row }
+end
+
+-- Cristal de vida del avatar (objetivo "Avatar"): columna izquierda, entre Combate y Banca
+function Layout.vital(side)
+	return { x = -Layout.SIDE_X, z = sign(side) * (Layout.ROW_COMBAT + Layout.ROW_BENCH) / 2 }
+end
+
+-- Mazo: columna derecha, a la altura de la Banca
+function Layout.deck(side)
+	return { x = Layout.SIDE_X, z = sign(side) * Layout.ROW_BENCH }
+end
+
+-- Cementerio: columna derecha, a la altura del Combate
+function Layout.graveyard(side)
+	return { x = Layout.SIDE_X, z = sign(side) * Layout.ROW_COMBAT }
+end
+
+-- Orbe central. attacker: "Self" | "Enemy" | nil (neutro). Se desplaza hacia quien ataca.
+function Layout.orb(attacker)
+	local z = 0
+	if attacker then z = sign(attacker) * 1.2 end
+	return { x = 0, z = z }
+end
+
+-- Semi-extensiones de la mesa jugable (sin marco)
+function Layout.halfExtents()
+	local halfX = Layout.SIDE_X + 3
+	local halfZ = Layout.ROW_BENCH + Layout.CARD.d / 2 + 2.5
+	return { x = halfX, z = halfZ }
+end
+
+-- Región de pantalla (fracciones 0..1) que dejan libre los paneles 2D.
+-- Coincide con el diseño actual: tablero entre el panel izquierdo y el derecho, sobre la mano.
+Layout.SCREEN_REGION = { x0 = 0.15, x1 = 0.83, y0 = 0.08, y1 = 0.76 }
+
+-- Encuadre de cámara para que la mesa quepa en `region` de la pantalla.
+-- aspect = ancho/alto de la pantalla · vfovDeg = FOV vertical · pitchDeg = inclinación bajo el horizonte.
+-- Devuelve { distance, shift }:
+--   distance: distancia cámara→centro (studs)
+--   shift: cuánto se baja la mirada (radianes) para que el centro de la mesa caiga en el centro de la región
+function Layout.cameraFit(aspect, vfovDeg, pitchDeg, region, margin)
+	region = region or Layout.SCREEN_REGION
+	margin = margin or 1.12
+	local half = Layout.halfExtents()
+	local tanV = math.tan(math.rad(vfovDeg) / 2)
+	local tanH = tanV * aspect
+	local regionW = region.x1 - region.x0
+	local regionH = region.y1 - region.y0
+	local sinP = math.sin(math.rad(pitchDeg))
+
+	-- Ancho: la mesa debe caber en regionW del ancho visible a esa distancia
+	local dW = half.x / (regionW * tanH)
+	-- Alto: la profundidad se proyecta con sin(pitch); sumamos algo por la altura de los pilares
+	local dH = (half.z * sinP + 3) / (regionH * tanV)
+
+	-- Centro de la región en coordenadas NDC (-1..1, +1 = arriba)
+	local ndcY = 1 - (region.y0 + region.y1)
+	return {
+		distance = math.max(dW, dH) * margin,
+		shift = math.atan(ndcY * tanV),
+	}
+end
+
+return Layout
diff --git a/tests/Layout.spec.luau b/tests/Layout.spec.luau
new file mode 100644
index 0000000..2b286e5
--- /dev/null
+++ b/tests/Layout.spec.luau
@@ -0,0 +1,40 @@
+local Layout = require("../src/StarterPlayerScripts/AEVUM/UI3D/Layout")
+
+local function expect(condition, message)
+	if not condition then error(message, 2) end
+end
+local function near(a, b) return math.abs(a - b) < 1e-6 end
+
+-- Casillas: centradas en X, índice 1 a la izquierda, bandos en lados opuestos de Z
+expect(near(Layout.slotX(3, 5), 0), "la casilla central debe estar en x = 0")
+expect(near(Layout.slotX(1, 5), -2 * Layout.SLOT_PITCH), "la casilla 1 debe estar a la izquierda")
+expect(near(Layout.slotX(5, 5), 2 * Layout.SLOT_PITCH), "la casilla 5 debe estar a la derecha")
+expect(Layout.slot("Self", "Combat", 1).z > 0, "el jugador local va en +Z")
+expect(Layout.slot("Enemy", "Combat", 1).z < 0, "el rival va en -Z")
+expect(near(Layout.slot("Self", "Bench", 2).z, -Layout.slot("Enemy", "Bench", 2).z), "los bandos son simétricos")
+expect(math.abs(Layout.slot("Self", "Bench", 1).z) > math.abs(Layout.slot("Self", "Combat", 1).z), "la Banca queda detrás del Combate")
+
