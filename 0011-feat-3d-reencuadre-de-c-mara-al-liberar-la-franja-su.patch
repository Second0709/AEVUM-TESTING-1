---
 src/StarterPlayerScripts/AEVUM/UI3D/Layout.luau | 5 +++--
 tests/Layout.spec.luau                          | 3 +++
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/StarterPlayerScripts/AEVUM/UI3D/Layout.luau b/src/StarterPlayerScripts/AEVUM/UI3D/Layout.luau
index e8820f5..7c3f262 100644
--- a/src/StarterPlayerScripts/AEVUM/UI3D/Layout.luau
+++ b/src/StarterPlayerScripts/AEVUM/UI3D/Layout.luau
@@ -121,8 +121,9 @@ function Layout.halfExtents()
 end
 
 -- Región de pantalla (fracciones 0..1) que dejan libre los paneles 2D.
--- Coincide con el diseño actual: tablero entre el panel izquierdo y el derecho, sobre la mano.
-Layout.SCREEN_REGION = { x0 = 0.15, x1 = 0.83, y0 = 0.08, y1 = 0.76 }
+-- Tablero entre el panel izquierdo y el derecho, sobre la mano. Sin barra superior (y0 = 0.04: un pequeño margen
+-- bajo el borde de la pantalla; los botones de Roblox quedan a la izquierda de x0).
+Layout.SCREEN_REGION = { x0 = 0.15, x1 = 0.83, y0 = 0.04, y1 = 0.76 }
 
 -- Encuadre de cámara para que la mesa quepa en `region` de la pantalla.
 -- aspect = ancho/alto de la pantalla · vfovDeg = FOV vertical · pitchDeg = inclinación bajo el horizonte.
diff --git a/tests/Layout.spec.luau b/tests/Layout.spec.luau
index 286eeb6..07cc60f 100644
--- a/tests/Layout.spec.luau
+++ b/tests/Layout.spec.luau
@@ -74,6 +74,9 @@ local near46 = Layout.cameraFit(16 / 9, 45, 46)
 expect(near46.distance < Layout.cameraFit(16 / 9, 45, 58).distance, "pitch 46° acerca la cámara")
 local px = Layout.cardScreenWidth(16 / 9, 45, 46, 1080)
 expect(px >= 80, "una carta debe medir >= 80 px de ancho a 1080p (mide " .. string.format("%.1f", px) .. ")")
+-- Sin barra superior la región sube y la carta crece (antes 84 px con y0 = 0.08)
+expect(Layout.SCREEN_REGION.y0 <= 0.05, "la región ya no deja sitio a la barra superior")
+expect(px >= 86, "sin barra superior la carta debe medir >= 86 px a 1080p (mide " .. string.format("%.1f", px) .. ")")
 -- La mesa no puede quedar recortada en vertical (móvil): la distancia debe seguir creciendo
 expect(Layout.cameraFit(9 / 16, 45, 46).distance > Layout.cameraFit(4 / 3, 45, 46).distance, "en vertical la cámara se aleja más")
 
